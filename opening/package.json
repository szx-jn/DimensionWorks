{
  "name": "dimensionworks-opening",
  "version": "0.1.0",
  "description": "DimensionWorks opening animation",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "render": "remotion render DimensionWorksOpening out/dimensionworks-opening.mp4 --codec=h264 --crf=17",
    "still": "remotion still DimensionWorksOpening out/dimensionworks-opening-poster.png --frame=855",
    "check": "tsc --noEmit",
    "score": "node scripts/generate-opening-score.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/media": "4.0.530",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
