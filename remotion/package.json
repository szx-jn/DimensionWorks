{
  "name": "dimensionworks-intro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "assets": "python3 scripts/generate_assets.py && python3 scripts/generate_memory_assets.py && python3 scripts/generate_soundscape.py",
    "voiceover": "python3 scripts/generate_voiceover.py",
    "studio": "npm run assets && remotion studio src/index.ts",
    "render": "npm run assets && remotion render src/index.ts DimensionWorksIntro out/dimensionworks-intro.mp4",
    "promo:audio": "python3 scripts/generate_promo_neural_audio.py",
    "promo:models": "python3 scripts/prepare_promo_models.py",
    "promo:check": "node scripts/check_promo.mjs",
    "promo:qa": "node --max-old-space-size=1536 scripts/render_promo.mjs qa",
    "promo:sample": "node --max-old-space-size=1536 scripts/render_promo.mjs sample",
    "promo:render": "node --max-old-space-size=1536 scripts/render_promo.mjs render",
    "promo:textures": "python3 scripts/prepare_promo_textures.py"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "@remotion/cli": "4.0.287",
    "@remotion/three": "4.0.287",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.287",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/three": "0.180.0",
    "typescript": "5.8.3"
  }
}
